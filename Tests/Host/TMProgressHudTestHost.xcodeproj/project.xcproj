      "build-settings": {
        "CODE_SIGNING_ALLOWED": "NO",
        "INFOPLIST_FILE": "Info.plist",
        "INFOPLIST_FILE[sdk=appletv*]": "Info-tvOS.plist",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.tmprogresshud.testhost",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator appletvos appletvsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_TREAT_WARNINGS_AS_ERRORS": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TARGETED_DEVICE_FAMILY[sdk=appletv*]": "3",
        "TVOS_DEPLOYMENT_TARGET": "17.0"
      },
      "product-type": "application"
    },
    {
      "name": "TMProgressHudUIKitTests",
      "id": "B00000000000000000000001",
      "product": "Products/TMProgressHudUIKitTests.xctest",
      "dependencies": [
        "TMProgressHudTestHost",
        "TMProgressHudUIKit"
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed framework",
          "bundle-base-path": "frameworks-directory",
          "relative-path": ""
        }
      ],
      "package-product-members": [],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGNING_ALLOWED": "NO",
        "ENABLE_TESTING_SEARCH_PATHS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@loader_path/Frameworks",
          "@executable_path/Frameworks"
        ],
        "OTHER_SWIFT_FLAGS": [
          "$(inherited)",
          "-Xcc",
          "-fmodule-map-file=$(SRCROOT)/Reference.modulemap"
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.tmprogresshud.tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator appletvos appletvsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_TREAT_WARNINGS_AS_ERRORS": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TARGETED_DEVICE_FAMILY[sdk=appletv*]": "3",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/TMProgressHudTestHost.app/TMProgressHudTestHost",
        "TVOS_DEPLOYMENT_TARGET": "17.0"
      },
      "product-type": "bundle.unit-test"
    },
